{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "{{hook_python}} \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-paths.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{hook_python}} \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{hook_python}} \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-end.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{hook_python}} \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-verify.py\"",
            "timeout": 900
          }
        ]
      }
    ]
  }
}
