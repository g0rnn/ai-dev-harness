{
  "uid": "harness-evidence",
  "title": "harness 실행 근거",
  "tags": [
    "harness",
    "agentops"
  ],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "DS_LOKI",
        "label": "Loki",
        "type": "datasource",
        "query": "loki",
        "current": {
          "text": "loki",
          "value": "loki"
        }
      },
      {
        "name": "repo",
        "label": "저장소 정규식",
        "type": "textbox",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        }
      },
      {
        "name": "member",
        "label": "사람 정규식",
        "type": "textbox",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        }
      },
      {
        "name": "task",
        "label": "작업 정규식",
        "type": "textbox",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "수집된 사건 · 종류별",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (harness_evidence_kind) (count_over_time({service_name=\"harness-agentops\"} | harness_repo=~\"$repo\" | member=~\"$member\" | harness_evidence_task=~\"$task\" [$__auto]))",
          "queryType": "range",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "기록 없음"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "title": "검증 기록 · 결과별",
      "type": "timeseries",
      "description": "검증 시도 기록이다. 캐시와 재시도는 별도 사건이며 작업 성공률과 다르다.",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (harness_evidence_status) (count_over_time({service_name=\"harness-agentops\"} | harness_repo=~\"$repo\" | member=~\"$member\" | harness_evidence_task=~\"$task\" | harness_evidence_kind=\"verification\" [$__auto]))",
          "queryType": "range",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "기록 없음"
        },
        "overrides": []
