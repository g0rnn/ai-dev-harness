{
  "harness_version": "0.3.6",
  "project_name": "ai-dev-harness",
  "platform": "github",
  "tracker": "github",
  "issue_prefix": "",
  "default_branch": "main",
  "integration_branch": "main",
  "related_docs": [
    {"label": "저장소 기여 규칙(브랜치·커밋·PR)", "path": "docs/contributing.md"},
    {"label": "Secret 및 환경변수 관리 규칙", "path": "docs/secret-environment-variables.md"},
    {"label": "개발 계획과 마일스톤", "path": "docs/roadmap.md"}
  ],
  "hooks": {
    "stop_verify": ["python -m unittest discover tests -q", "python bin/harness.py check --self"],
    "stop_timeout_sec": 780,
    "python": "python"
  },
  "judge": {
    "trigger_paths": {
      "strict": [
        "/core/hooks/protect-paths.py", "/core/hooks/stop-verify.py",
      "/core/hooks/session-start.py", "/core/hooks/settings.template.json",
        "/.claude/settings.json", "/.claude/hooks/protect-paths.py", "/.claude/hooks/stop-verify.py",
      "/.claude/hooks/session-start.py",
        "/core/ci/gitlab/secret-detection.yml", "/core/ci/gitlab/sast.yml",
        "/core/ci/gitlab/dependency-audit.yml", "/core/ci/gitlab/image-scan.yml",
        "/.github/workflows/security.yml", "/.github/scripts/run_fragment.py"
      ],
      "standard": [
        "/core/", "/bin/", "/.github/", "/profiles/", "/AGENTS.md", "/CLAUDE.md", "/README.md", "/harness.json",
        "/docs/templates/", "/docs/adr/0000-template.md", "/docs/ai-collaboration.md",
        "/docs/secret-environment-variables.md"
      ]
    },
    "test_paths": ["/tests/"],
    "triggers": [
      "core/hooks/harness_common.py의 차단·수정 로직 변경이면 엄격",
      ".github/workflows/ci.yml의 보안 검사 리허설 단계나 .github/scripts/rehearse.py의 보안 시나리오 변경이면 엄격",
      "harness.json 스키마·CLI 인자·자리표시자 이름·판정 식별자를 깨는 변경이면 첫 소비자 적용 뒤 엄격"
    ]
  }
}
